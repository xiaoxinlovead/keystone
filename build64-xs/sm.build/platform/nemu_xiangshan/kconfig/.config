
#
# Platform Options
#
CONFIG_PLATFORM_NEMU_XIANGSHAN=y
CONFIG_PLATFORM_NEMU_XIANGSHAN_NAME="NEMU-Xiangshan"
CONFIG_PLATFORM_NEMU_XIANGSHAN_MAJOR_VER=0
CONFIG_PLATFORM_NEMU_XIANGSHAN_MINOR_VER=1
CONFIG_PLATFORM_NEMU_XIANGSHAN_FDT_EMPTY_SPACE=4
# end of Platform Options

#
# Generic SBI Support
#
CONFIG_CONSOLE_EARLY_BUFFER_SIZE=256
CONFIG_SBI_ECALL_TIME=y
CONFIG_SBI_ECALL_RFENCE=y
CONFIG_SBI_ECALL_IPI=y
CONFIG_SBI_ECALL_HSM=y
CONFIG_SBI_ECALL_SRST=y
CONFIG_SBI_ECALL_SUSP=y
CONFIG_SBI_ECALL_PMU=y
CONFIG_SBI_ECALL_DBCN=y
CONFIG_SBI_ECALL_CPPC=y
CONFIG_SBI_ECALL_FWFT=y
CONFIG_SBI_ECALL_LEGACY=y
# CONFIG_SBI_ECALL_VENDOR is not set
CONFIG_SBI_ECALL_DBTR=y
# CONFIG_SBIUNIT is not set
CONFIG_SBI_ECALL_SSE=y
CONFIG_SBI_ECALL_MPXY=y
# end of Generic SBI Support

#
# Utils and Drivers Support
#

#
# Cache Support
#
# CONFIG_FDT_CACHE is not set
# CONFIG_CACHE is not set
# end of Cache Support

#
# CPPC Device Support
#
# CONFIG_FDT_CPPC is not set
# end of CPPC Device Support

CONFIG_FDT=y
CONFIG_FDT_DOMAIN=y
CONFIG_FDT_PMU=y
# CONFIG_FDT_FIXUPS_PRESERVE_PMU_NODE is not set

#
# GPIO Support
#
# CONFIG_FDT_GPIO is not set
# CONFIG_GPIO is not set
# end of GPIO Support

#
# HSM Device Support
#
# CONFIG_FDT_HSM is not set
# end of HSM Device Support

#
# I2C Support
#
# CONFIG_FDT_I2C is not set
# CONFIG_I2C_DW is not set
# CONFIG_I2C is not set
# end of I2C Support

#
# IPI Device Support
#
CONFIG_FDT_IPI=y
CONFIG_FDT_IPI_MSWI=y
# CONFIG_FDT_IPI_PLICSW is not set
CONFIG_IPI_MSWI=y
# CONFIG_IPI_PLICSW is not set
# end of IPI Device Support

#
# Interrupt Controller Support
#
CONFIG_FDT_IRQCHIP=y
CONFIG_FDT_IRQCHIP_APLIC=y
CONFIG_FDT_IRQCHIP_IMSIC=y
# CONFIG_FDT_IRQCHIP_PLIC is not set
CONFIG_IRQCHIP_APLIC=y
CONFIG_IRQCHIP_IMSIC=y
# CONFIG_IRQCHIP_PLIC is not set
# end of Interrupt Controller Support

CONFIG_LIBFDT=y

#
# Mailbox Support
#
# CONFIG_FDT_MAILBOX is not set
# CONFIG_RPMI_MAILBOX is not set
# CONFIG_MAILBOX is not set
# end of Mailbox Support

#
# Regmap Support
#
# CONFIG_FDT_REGMAP is not set
# CONFIG_REGMAP is not set
# end of Regmap Support

#
# System Reset Support
#
CONFIG_FDT_RESET=y
CONFIG_FDT_RESET_HTIF=y
# CONFIG_FDT_RESET_SG2042_HWMON_MCU is not set
# CONFIG_FDT_RESET_SUNXI_WDT is not set
# end of System Reset Support

#
# Serial Device Support
#
CONFIG_FDT_SERIAL=y
# CONFIG_FDT_SERIAL_ALTR_JUART is not set
# CONFIG_FDT_SERIAL_CADENCE is not set
# CONFIG_FDT_SERIAL_GAISLER is not set
# CONFIG_FDT_SERIAL_HTIF is not set
# CONFIG_FDT_SERIAL_RENESAS_SCIF is not set
# CONFIG_FDT_SERIAL_SHAKTI is not set
# CONFIG_FDT_SERIAL_SIFIVE is not set
# CONFIG_FDT_SERIAL_LITEX is not set
CONFIG_FDT_SERIAL_UART8250=y
CONFIG_FDT_SERIAL_XILINX_UARTLITE=y
# CONFIG_SERIAL_ALTR_JUART is not set
# CONFIG_SERIAL_CADENCE is not set
# CONFIG_SERIAL_GAISLER is not set
# CONFIG_SERIAL_RENESAS_SCIF is not set
# CONFIG_SERIAL_SHAKTI is not set
# CONFIG_SERIAL_SIFIVE is not set
# CONFIG_SERIAL_LITEX is not set
CONFIG_SERIAL_UART8250=y
CONFIG_SERIAL_XILINX_UARTLITE=y
CONFIG_SERIAL_SEMIHOSTING=y
# end of Serial Device Support

#
# System Suspend Support
#
# CONFIG_FDT_SUSPEND is not set
# end of System Suspend Support

#
# System Device Support
#
CONFIG_SYS_HTIF=y
# end of System Device Support

#
# Timer Device Support
#
CONFIG_FDT_TIMER=y
CONFIG_FDT_TIMER_MTIMER=y
# CONFIG_FDT_TIMER_PLMT is not set
CONFIG_TIMER_MTIMER=y
# CONFIG_TIMER_PLMT is not set
# end of Timer Device Support

#
# MPXY Device Support
#
# CONFIG_FDT_MPXY is not set
# end of MPXY Device Support
# end of Utils and Drivers Support

#
# Stack Protector Support
#
# CONFIG_STACK_PROTECTOR is not set
# end of Stack Protector Support
